<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — VerifiedBulk</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ canonical }}">
{%- set og = (ogcardUrl or (site.url + '/assets/og-default.png')) %}
<meta property="og:type" content="{{ 'article' if layout == 'guide.njk' else 'website' }}">
<meta property="og:site_name" content="VerifiedBulk">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ og }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{%- if layout == 'guide.njk' %}
<meta property="article:published_time" content="{{ date | isoDate }}">
<meta property="article:modified_time" content="{{ (updated or date) | isoDate }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ og }}">
<link rel="icon" type="image/svg+xml" href="/assets/icons/mark.svg">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Instrument+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/site.css">
{% include "ga4.njk" %}
